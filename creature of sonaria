local optimizeBackup = nil
local function applyOptimize()
    if not optimizeBackup then
        optimizeBackup = {
            GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd,
        }
    end
    pcall(function() Lighting.GlobalShadows = false end)
    pcall(function() Lighting.FogEnd = 100000 end)
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.Material = Enum.Material.Plastic
                part.Reflectance = 0
                part.CastShadow = false
            end)
            for _, child in ipairs(part:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    pcall(function() child.Transparency = 1 end)
                elseif child:IsA("ParticleEmitter") or child:IsA("Trail")
                    or child:IsA("Beam") or child:IsA("Smoke")
                    or child:IsA("Fire") or child:IsA("Sparkles") then
                    pcall(function() child.Enabled = false end)
                end
            end
        end
    end
    pcall(function()
        local t = workspace:FindFirstChildOfClass("Terrain")
        if t then t.Decoration = false end
    end)
end
local function restoreOptimize()
    if not optimizeBackup then return end
    pcall(function() Lighting.GlobalShadows = optimizeBackup.GlobalShadows end)
    pcall(function() Lighting.FogEnd = optimizeBackup.FogEnd end)
    optimizeBackup = nil
end

