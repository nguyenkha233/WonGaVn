local function startMain()
    local ok, err = pcall(function()
        Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    end)
    if not ok or not Rayfield then
        warn("[WonGaVn] Không load được Rayfield: " .. tostring(err)); return
    end
    task.wait(0.5)

    local ok2, err2 = pcall(buildMenu)
    if not ok2 then
        warn("[WonGaVn] buildMenu lỗi: " .. tostring(err2)); return
    end

    task.wait(1)
    enableAntiban()
    task.wait(0.5)
    pcall(applyMenuTheme)
    sysNotify("loaded")

    task.spawn(function()
        while _G.WGVersion == MY_VERSION do
            task.wait(30)
            saveFullConfig()
        end
    end)
end

if S.systemName and S.systemName ~= "Chưa đặt tên" and #S.systemName > 0 then
    startMain()
else
    showIntro(function(name)
        task.wait(0.2)
        startMain()
    end)
end
