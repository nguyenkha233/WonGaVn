local function restartScript()
    -- Đánh dấu version mới → loop cũ tự chết
    _G.WGVersion = _G.WGVersion + 1

    -- Xóa toàn bộ GUI
    pcall(function()
        for _, g in ipairs(game:GetService("CoreGui"):GetChildren()) do
            local nm = g.Name:lower()
            if nm:find("rayfield") or nm:find("sirius") or nm:find("wg") then
                g:Destroy()
            end
        end
    end)
    pcall(function()
        if gethui then
            for _, g in ipairs(gethui():GetChildren()) do
                local nm = g.Name:lower()
                if nm:find("rayfield") or nm:find("sirius") or nm:find("wg") then
                    g:Destroy()
                end
            end
        end
    end)

    task.wait(1.5)
    pcall(function()
        loadstring(game:HttpGet(SCRIPT_URL))()
    end)
end

