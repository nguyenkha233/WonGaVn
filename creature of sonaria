local function injectLogoIntoLoading()
    task.spawn(function()
        for attempt = 1, 40 do
            local parent = (gethui and gethui()) or game:GetService("CoreGui")
            local rayGui = nil
            for _, g in ipairs(parent:GetChildren()) do
                if g:IsA("ScreenGui") then
                    local nm = g.Name:lower()
                    if nm:find("rayfield") or nm:find("sirius") then rayGui = g; break end
                end
            end
            if rayGui then
                local existing = rayGui:FindFirstChild("WG_CustomLogo")
                if existing then existing:Destroy() end
                local logo = Instance.new("ImageLabel")
                logo.Name = "WG_CustomLogo"
                logo.Size = UDim2.new(0, 140, 0, 140)
                logo.Position = UDim2.new(0.5, -70, 0.5, -200)
                logo.BackgroundTransparency = 1
                logo.Image = _G.WGLogoId
                logo.ZIndex = 999999
                logo.Parent = rayGui
                task.spawn(function()
                    local t = 0
                    while logo.Parent do
                        t = t + 0.05
                        pcall(function()
                            logo.ImageTransparency = 0.1 + 0.1 * math.sin(t)
                        end)
                        task.wait(0.05)
                    end
                end)
                return
            end
            task.wait(0.25)
        end
    end)
end

