local antiDeathThread = nil

local function startAntiDeath()
    if antiDeathThread then pcall(function() task.cancel(antiDeathThread) end) end
    antiDeathThread = task.spawn(function()
        local safeReturn = nil
        local sentAway = false
        while S.antiDeathOn do
            local c = LP.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                local hpPct = (h.Health / math.max(h.MaxHealth, 1)) * 100
                local threshold = S.antiDeathThreshold or 30

                if not sentAway and hpPct <= threshold then
                    safeReturn = hrp.Position
                    h.PlatformStand = true
                    local farX = (math.random() > 0.5 and 1 or -1) * (3000 + math.random() * 1000)
                    local farZ = (math.random() > 0.5 and 1 or -1) * (3000 + math.random() * 1000)
                    hrp.CFrame = CFrame.new(Vector3.new(farX, 800, farZ))
                    hrp.Velocity = Vector3.zero
                    sentAway = true
                    pcall(function()
                        Rayfield:Notify({Title = "💀 " .. S.systemName,
                            Content = "máu thấp — đang trốn để hồi máu...", Duration = 4})
                    end)
                end

                if sentAway then
                    if hpPct >= math.min(threshold + 30, 95) then
                        if safeReturn then
                            hrp.CFrame = CFrame.new(safeReturn + Vector3.new(0, 3, 0))
                        end
                        h.PlatformStand = false
                        sentAway = false
                        safeReturn = nil
                        pcall(function()
                            Rayfield:Notify({Title = "✅ " .. S.systemName,
                                Content = "hồi máu xong — quay lại.", Duration = 3})
                        end)
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

local function stopAntiDeath()
    if antiDeathThread then
        pcall(function() task.cancel(antiDeathThread) end)
        antiDeathThread = nil
        local c = LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
end

