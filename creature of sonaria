        })
        TabUtil:CreateInput({
            Name = "Nội dung tin nhắn", CurrentValue = S.spamChatMsg,
            PlaceholderText = "WonGaVn on top", RemoveTextAfterFocusLost = false, Flag = "SpamMsg",
            Callback = function(t) if t and #t > 0 then S.spamChatMsg = t end end
        })
        TabUtil:CreateSlider({
            Name = "Delay spam", Range = {0.3,5}, Increment = 0.1,
            Suffix = "s", CurrentValue = S.spamChatDelay, Flag = "SpamDelay",
            Callback = function(v) S.spamChatDelay = v end
        })

        TabUtil:CreateSection("🔄 Auto Trade")
        TabUtil:CreateToggle({
            Name = "Auto Trade (ghi log)", CurrentValue = S.autoTradeOn, Flag = "AutoTrade",
            Callback = function(v)
                S.autoTradeOn = v
                if v then
