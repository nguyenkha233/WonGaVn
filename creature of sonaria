        TabUtil:CreateToggle({
            Name = "🕊️ Fly", CurrentValue = S.flyOn, Flag = "Fly",
            Callback = function(v) S.flyOn = v; if v then sysNotify("fly") end end
        })
        TabUtil:CreateSlider({
            Name = "Tốc độ bay", Range = {10,500}, Increment = 10,
            Suffix = "", CurrentValue = S.flySpeed, Flag = "FlySpeed",
            Callback = function(v) S.flySpeed = v end
        })

        TabUtil:CreateSection("🌀 Cổng Xuyên Không")
        TabUtil:CreateButton({
            Name = "🪟 Mở Menu Cổng (kéo thả được)",
