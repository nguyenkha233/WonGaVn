local function nameIsShoomPile(name)
    if not name then return false end
    local n = name:lower()
    return n:find("shoom pile", 1, true) ~= nil
        or n:find("shoompile", 1, true) ~= nil
        or n:find("shoom_pile", 1, true) ~= nil
        or n:find("silver shoom", 1, true) ~= nil
        or n:find("gold shoom", 1, true) ~= nil
end

local function getColorType(color)
    if not color then return nil end
    local r, g, b = color.R, color.G, color.B
    if r > 0.6 and g < 0.45 and b < 0.45 then return "red" end
    if b > 0.55 and r < 0.55 and g < 0.75 then return "blue" end
    if r > 0.7 and g > 0.55 and b < 0.45 then return "gold" end
    return nil
end

local function getPartColor(obj)
    if obj:IsA("BasePart") then return obj.Color end
    for _, p in ipairs(obj:GetDescendants()) do
        if p:IsA("BasePart") then return p.Color end
    end
    return nil
end

local function getShroomSize(obj)
    if obj:IsA("BasePart") then return obj.Size end
    local ok, ext = pcall(function() return obj:GetExtentsSize() end)
    if not ok then return nil end
    return ext
end

local function detectShroom(obj)
    if not obj or not obj.Parent then return false, nil end
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false, nil end
    local matched = nameIsShoomPile(obj.Name)
    if not matched and obj.Parent then
        matched = nameIsShoomPile(obj.Parent.Name)
    end
    if not matched then return false, nil end
    local sz = getShroomSize(obj)
    if not sz then return false, nil end
    if sz.X < 8 or sz.Z < 8 or sz.Y < 3 then return false, nil end
    local nameLower = obj.Name:lower()
    local colorType = nil
    if nameLower:find("silver", 1, true) then colorType = "blue"
    elseif nameLower:find("gold", 1, true) then colorType = "gold"
    else
        local col = getPartColor(obj)
        colorType = getColorType(col) or "red"
    end
    return true, colorType
end

local function findShrooms()
    local list = {}
    local seen = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and obj.Parent then
            local ok, ctype = detectShroom(obj)
            if ok then
                local rootObj = obj
                if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model")
                   and nameIsShoomPile(obj.Parent.Name) then
                    rootObj = obj.Parent
                end
                if not seen[rootObj] then
                    seen[rootObj] = true
                    table.insert(list, {obj = rootObj, colorType = ctype})
                end
            end
        end
    end
    return list
end

local function getShroomPos(m)
    if not m or not m.Parent then return nil end
    if m:IsA("BasePart") then return m.Position end
    if m.PrimaryPart then return m.PrimaryPart.Position end
    local bp = m:FindFirstChildWhichIsA("BasePart")
    if bp then return bp.Position end
    return nil
end

local function collectShroom(obj)
    if not obj or not obj.Parent then return end
    for _, r in ipairs(collectRemotes) do
        pcall(function() r:FireServer(obj) end)
    end
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp and firetouchinterest then
        if obj:IsA("BasePart") then
            pcall(function()
                firetouchinterest(hrp, obj, 0)
                firetouchinterest(hrp, obj, 1)
            end)
        elseif obj:IsA("Model") then
            for _, p in ipairs(obj:GetDescendants()) do
                if p:IsA("BasePart") then
                    pcall(function()
                        firetouchinterest(hrp, p, 0)
                        firetouchinterest(hrp, p, 1)
                    end)
                end
            end
        end
    end
    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
    if not prompt and obj:IsA("Model") then
        prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if prompt and fireproximityprompt then
        pcall(function() fireproximityprompt(prompt) end)
    end
end

local function readShroomQuest()
    for _, gui in ipairs(LP.PlayerGui:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("TextButton") then
            local txt = (gui.Text or ""):lower()
            if txt:find("shoom", 1, true) or txt:find("shroom", 1, true)
               or txt:find("pile", 1, true) then
                local cur, total = txt:match("(%d+)%s*/%s*(%d+)")
                if cur and total then
                    cur, total = tonumber(cur), tonumber(total)
                    if cur and total and total > 0 and cur >= 0 then
                        return cur, total
                    end
                end
            end
        end
    end
    return nil, nil
end

local function clusterShrooms(shrooms, clusterDist)
    clusterDist = clusterDist or 350
    local clusters = {}
    local used = {}
    for _, item in ipairs(shrooms) do
        if not used[item.obj] then
            local p1 = getShroomPos(item.obj)
            if p1 then
                local cluster = {item}
                used[item.obj] = true
                for _, other in ipairs(shrooms) do
                    if not used[other.obj] then
                        local p2 = getShroomPos(other.obj)
                        if p2 and (p1 - p2).Magnitude <= clusterDist then
                            table.insert(cluster, other)
                            used[other.obj] = true
                        end
                    end
                end
                table.insert(clusters, {members = cluster, center = p1})
            end
        end
    end
    return clusters
end

