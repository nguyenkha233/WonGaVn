local freecamState = { active=false, speed=2 }
local function startFreecam()
    local cam = workspace.CurrentCamera
    freecamState.origCFrame = cam.CFrame
    freecamState.origType = cam.CameraType
    cam.CameraType = Enum.CameraType.Scriptable
    freecamState.camera = cam
    freecamState.camCF = cam.CFrame
    freecamState.moving = {}
    freecamState.inputConn = UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        local k = input.KeyCode
        if k == Enum.KeyCode.W then freecamState.moving.W = true
        elseif k == Enum.KeyCode.S then freecamState.moving.S = true
        elseif k == Enum.KeyCode.A then freecamState.moving.A = true
        elseif k == Enum.KeyCode.D then freecamState.moving.D = true
        elseif k == Enum.KeyCode.Space then freecamState.moving.UP = true
        elseif k == Enum.KeyCode.LeftShift then freecamState.moving.DOWN = true end
    end)
    freecamState.inputEndConn = UIS.InputEnded:Connect(function(input)
        local k = input.KeyCode
        if k == Enum.KeyCode.W then freecamState.moving.W = nil
        elseif k == Enum.KeyCode.S then freecamState.moving.S = nil
        elseif k == Enum.KeyCode.A then freecamState.moving.A = nil
        elseif k == Enum.KeyCode.D then freecamState.moving.D = nil
        elseif k == Enum.KeyCode.Space then freecamState.moving.UP = nil
        elseif k == Enum.KeyCode.LeftShift then freecamState.moving.DOWN = nil end
    end)
    freecamState.mouseConn = UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Delta
            local camCF = freecamState.camCF or cam.CFrame
            local newRot = CFrame.Angles(0, -math.rad(delta.X * 0.4), 0) * CFrame.Angles(-math.rad(delta.Y * 0.4), 0, 0)
            freecamState.camCF = newRot * camCF
        end
    end)
    freecamState.renderConn = RunService.RenderStepped:Connect(function()
        local dir = Vector3.zero
        local camCF = freecamState.camCF or cam.CFrame
        local look = camCF.LookVector
        local right = camCF.RightVector
        if freecamState.moving.W then dir = dir + look end
        if freecamState.moving.S then dir = dir - look end
        if freecamState.moving.A then dir = dir - right end
        if freecamState.moving.D then dir = dir + right end
        if freecamState.moving.UP then dir = dir + Vector3.new(0,1,0) end
        if freecamState.moving.DOWN then dir = dir - Vector3.new(0,1,0) end
        if dir.Magnitude > 0 then freecamState.camCF = camCF + dir.Unit * freecamState.speed end
        cam.CFrame = freecamState.camCF or camCF
    end)
end
local function stopFreecam()
    if freecamState.inputConn then freecamState.inputConn:Disconnect() end
    if freecamState.inputEndConn then freecamState.inputEndConn:Disconnect() end
    if freecamState.mouseConn then freecamState.mouseConn:Disconnect() end
    if freecamState.renderConn then freecamState.renderConn:Disconnect() end
    if freecamState.camera then
        freecamState.camera.CameraType = freecamState.origType or Enum.CameraType.Custom
        if freecamState.origCFrame then freecamState.camera.CFrame = freecamState.origCFrame end
    end
    freecamState = { active=false, speed=2 }
end

