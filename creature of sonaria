local function applyHitbox(pl)
    if pl == LP then return end
    local c = pl.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if originals[pl] and originals[pl].part == hrp then
        if hrp.Size == Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize) then return end
    end
    if not originals[pl] or originals[pl].part ~= hrp then
        originals[pl] = {
            part = hrp,
            Size=hrp.Size, Transparency=hrp.Transparency,
            Material=hrp.Material, CanCollide=hrp.CanCollide, Color=hrp.Color
        }
    end
    hrp.Size = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
    hrp.Transparency = 1
    hrp.CanCollide = false
end

local function resetHitbox(pl)
    if pl == LP then return end
    local o = originals[pl]
    if o and o.part and o.part.Parent then
        o.part.Size = o.Size
        o.part.Transparency = o.Transparency
        o.part.Material = o.Material
        o.part.CanCollide = o.CanCollide
        o.part.Color = o.Color
    end
    originals[pl] = nil
end

