local spamThread, bypassThread = nil, nil
local CONFUSABLES = {
    ["a"]="а",["e"]="е",["o"]="о",["p"]="р",["c"]="с",["x"]="х",["y"]="у",
    ["A"]="А",["B"]="В",["E"]="Е",["H"]="Н",["K"]="К",["M"]="М",["O"]="О",
    ["P"]="Р",["C"]="С",["T"]="Т",["X"]="Х",["i"]="і",["l"]="ӏ",
}
local function applyUnicodeBypass(msg)
    local r = msg
    for f, t in pairs(CONFUSABLES) do r = r:gsub(f, t) end
    if S.bypassMode == "unicode" then r = r:gsub("(%a)", "%1\u{200B}") end
    return r
end
local function applyRichBypass(msg)
    local out = ""
    for i = 1, #msg do
        local c = msg:sub(i, i)
        if c:match("%a") then out = out .. c .. "&" else out = out .. c end
    end
    return out
end
local function getBypassedMessage(m)
    if S.bypassMode == "rich" then return applyRichBypass(m) else return applyUnicodeBypass(m) end
end
local function sendChatMessage(msg)
    local b = getBypassedMessage(msg)
    local ok = false
    pcall(function()
        local TCS = game:GetService("TextChatService")
        if TCS and TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            local ch = TCS:FindFirstChild("TextChannels")
            local rb = ch and ch:FindFirstChild("RBXGeneral")
            if rb then rb:SendAsync(b); ok = true end
        end
    end)
    if not ok then pcall(function() StarterGui:SetCore("ChatSendMessage", {b}) end) end
end
local function startSpamChat()
    if spamThread then pcall(function() task.cancel(spamThread) end) end
    spamThread = task.spawn(function()
        while S.spamChatOn do sendChatMessage(S.spamChatMsg); task.wait(S.spamChatDelay) end
    end)
end
local function stopSpamChat()
    if spamThread then pcall(function() task.cancel(spamThread) end); spamThread = nil end
end
local function startSpamBypass()
    if bypassThread then pcall(function() task.cancel(bypassThread) end) end
    local remotes = {}
    for _, v in pairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("chat") or n:find("say") or n:find("message") then table.insert(remotes, v) end
        end
    end
    bypassThread = task.spawn(function()
        while S.spamBypassOn do
            local b = getBypassedMessage(S.spamChatMsg)
            for _, r in ipairs(remotes) do
                pcall(function() r:FireServer(b) end)
            end
            task.wait(S.spamChatDelay)
        end
    end)
end
local function stopSpamBypass()
    if bypassThread then pcall(function() task.cancel(bypassThread) end); bypassThread = nil end
end

