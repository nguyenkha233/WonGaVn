local antibanDone = false
local BLOCK = {report=true,ban=true,kick=true,vote=true,cheat=true,anticheat=true,detect=true,flag=true,suspicious=true,scan=true,check=true}
local function isBlocked(a)
    if type(a) ~= "string" then return false end
    local s = a:lower()
    for k in pairs(BLOCK) do if s:find(k) then return true end end
    return false
end
local function enableAntiban()
    if antibanDone then return end
    antibanDone = true
    local mt = getrawmetatable and getrawmetatable(game)
    if mt and newcclosure and setreadonly then
        setreadonly(mt, false)
        local oldNC = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "Kick" then return end
            if m == "FireServer" or m == "InvokeServer" then
                for _, a in ipairs({...}) do
                    if isBlocked(a) then return end
                    if typeof(a) == "Instance" and a.Name and isBlocked(a.Name) then return end
                end
            end
            return oldNC(self, ...)
        end)
        local oldIdx = mt.__index
        local HIDE = {HttpGet=true,HttpPost=true,getgenv=true,getrenv=true,identifyexecutor=true,
            getexecutorname=true,getscriptbytecode=true,hookfunction=true,getrawmetatable=true}
        mt.__index = newcclosure(function(t, k)
            if HIDE[k] then return nil end
            return oldIdx(t, k)
        end)
        setreadonly(mt, true)
    end
    warn = function() end
end

