-- KHỞI ĐỘNG
local function startMain()
    local ok, err = pcall(function()
        Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
    end)
    if not ok or not Rayfield then
        warn("[WonGaVn] Không load được Rayfield: " .. tostring(err))
        return
    end
    task.wait(0.5)

    local ok2, err2 = pcall(buildMenu)
    if not ok2 then
        warn("[WonGaVn] buildMenu lỗi: " .. tostring(err2))
        return
    end

    task.wait(1)
    enableAntiban()
    task.wait(0.5)
    pcall(applyMenuTheme)

    pcall(function()
        Rayfield:Notify({Title = "⚡ " .. S.systemName, Content = getPLine("loaded"), Duration = 6})
    end)

    if not S.utilityUnlocked then
        task.wait(2)
        showSealPrompt(
            function() pcall(doUnlock) end,
            function()
                pcall(function()
                    Rayfield:Notify({
                        Title = "🔒 " .. S.systemName,
                        Content = "Phong ấn chưa vỡ... Ngươi hãy đến tìm ta khi sẵn sàng.",
                        Duration = 5
                    })
                end)
            end
        )
    end
end

if S.systemName and S.systemName ~= "Chưa đặt tên" and #S.systemName > 0 then
    startMain()
else
    showIntro(function(name)
        task.wait(0.2)
        startMain()
    end)
end
