local function destroyPortals()
    for _, info in ipairs(portals) do
        if info.part then pcall(function() info.part:Destroy() end) end
        if info.core then pcall(function() info.core:Destroy() end) end
        if info.ring then pcall(function() info.ring:Destroy() end) end
    end
    portals = {}
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "WG_Portal" then pcall(function() obj:Destroy() end) end
    end
end

local function destroyOnePortal(index)
    if portals[index] then
        if portals[index].part then pcall(function() portals[index].part:Destroy() end) end
        if portals[index].core then pcall(function() portals[index].core:Destroy() end) end
        if portals[index].ring then pcall(function() portals[index].ring:Destroy() end) end
        table.remove(portals, index)
    end
end

