local function clearMushroomESP()
    for part, hl in pairs(mushroomESP) do
        if hl then hl:Destroy() end
    end
    mushroomESP = {}
end

local function applyMushroomESP()
    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos = root.Position
    local MAXD = 500 * 500
    local MAXC = 60
    local count = 0
    local current = {}
    local function scan(parent, depth)
        if depth > 8 or count >= MAXC then return end
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("mushroom") or n:find("shroom") or n:find("shoom") then
                    local d2 = (obj.Position - myPos).Magnitude
                    if d2 * d2 <= MAXD and count < MAXC then
                        count = count + 1
                        current[obj] = true
                        if not mushroomESP[obj] then
                            mushroomESP[obj] = makeESP(obj)
                        end
                    end
                end
            elseif obj:IsA("Model") or obj:IsA("Folder") then
                scan(obj, depth + 1)
            end
        end
    end
    scan(workspace, 0)
    for part, hl in pairs(mushroomESP) do
        if not current[part] or not part.Parent then
            hl:Destroy(); mushroomESP[part] = nil
        end
    end
end

