local antiDeathThread = nil

local function findSafeSpot()
    for attempt = 1, 25 do
        local angle = math.random() * math.pi * 2
        local dist = 8000 + math.random() * 4000
        local x = math.cos(angle) * dist
        local z = math.sin(angle) * dist
        local y = 1500 + math.random() * 1500
        local pos = Vector3.new(x, y, z)
        local safe = true
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP then
                local pc = pl.Character
                local pr = pc and pc:FindFirstChild("HumanoidRootPart")
                if pr and (pr.Position - pos).Magnitude < 600 then
                    safe = false; break
                end
            end
        end
        if safe then return pos end
    end
    return Vector3.new(12000, 2500, 12000)
end

local function startAntiDeath()
    if antiDeathThread then pcall(function() task.cancel(antiDeathThread) end) end
    antiDeathThread = task.spawn(function()
        local safeReturn = nil
        local sentAway = false
        while S.antiDeathOn do
            local c = LP.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if h and hrp and h.Health > 0 then
                local hpPct = (h.Health / math.max(h.MaxHealth, 1)) * 100
                local threshold = S.antiDeathThreshold or 30
                if not sentAway and hpPct <= threshold then
                    safeReturn = hrp.Position
                    h.PlatformStand = true
                    hrp.CFrame = CFrame.new(findSafeSpot())
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    sentAway = true
                    pcall(function()
                        Rayfield:Notify({Title = "💀 " .. S.systemName,
                            Content = "máu thấp — đang trốn ở vùng an toàn...", Duration = 4})
                    end)
                end
                if sentAway then
                    local myPos = hrp.Position
                    local nearEnemy = false
                    for _, pl in ipairs(Players:GetPlayers()) do
                        if pl ~= LP then
                            local pc = pl.Character
                            local pr = pc and pc:FindFirstChild("HumanoidRootPart")
                            if pr and (pr.Position - myPos).Magnitude < 400 then
                                nearEnemy = true; break
                            end
                        end
                    end
                    if nearEnemy and hpPct < 95 then
                        hrp.CFrame = CFrame.new(findSafeSpot())
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                    if hpPct >= math.min(threshold + 30, 95) and not nearEnemy then
                        if safeReturn then
                            hrp.CFrame = CFrame.new(safeReturn + Vector3.new(0, 3, 0))
                        end
                        h.PlatformStand = false
                        sentAway = false
                        safeReturn = nil
                        pcall(function()
                            Rayfield:Notify({Title = "✅ " .. S.systemName,
                                Content = "hồi máu xong — quay lại.", Duration = 3})
                        end)
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

