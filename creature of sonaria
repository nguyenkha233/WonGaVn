local freecamActive = false
local freecamYaw, freecamPitch = 0, 0
local freecamZoom = 30
local freecamCenter = nil
local freecamLastTranslation = nil

local function startFreecam()
    if freecamActive then return end
    freecamActive = true
    local cam = workspace.CurrentCamera
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    freecamCenter = hrp and hrp.Position or Vector3.zero
    local cf = cam.CFrame
    freecamYaw = math.atan2(-cf.LookVector.X, -cf.LookVector.Z)
    freecamPitch = math.asin(math.clamp(cf.LookVector.Y, -1, 1))
    freecamZoom = 30
    freecamLastTranslation = nil
    cam.CameraSubject = nil
    cam.CameraType = Enum.CameraType.Scriptable
end
local function stopFreecam()
    if not freecamActive then return end
    freecamActive = false
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then cam.CameraSubject = h end
end

UIS.TouchPan:Connect(function(touchPositions, totalTranslation, velocity, state)
    if not freecamActive then return end
    if state == Enum.UserInputState.Begin then
        freecamLastTranslation = totalTranslation
        return
    end
    if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
        freecamLastTranslation = nil
        return
    end
    if not freecamLastTranslation then
        freecamLastTranslation = totalTranslation
        return
    end
    local delta = totalTranslation - freecamLastTranslation
    freecamLastTranslation = totalTranslation
    local sens = S.freecamSensitivity or 0.08
    freecamYaw = freecamYaw - math.rad(delta.X * sens * 100)
    freecamPitch = math.clamp(freecamPitch - math.rad(delta.Y * sens * 100), -math.rad(85), math.rad(85))
end)

UIS.TouchPinch:Connect(function(_, scale)
    if not freecamActive then return end
    freecamZoom = math.clamp(freecamZoom / scale, 5, 300)
end)

UIS.InputChanged:Connect(function(input)
    if not freecamActive then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            local d = input.Delta
            freecamYaw = freecamYaw - math.rad(d.X * 0.35)
            freecamPitch = math.clamp(freecamPitch - math.rad(d.Y * 0.35), -math.rad(85), math.rad(85))
        end
    elseif input.UserInputType == Enum.UserInputType.MouseWheel then
        freecamZoom = math.clamp(freecamZoom - input.Position.Z * 3, 5, 300)
    end
end)

RunService.RenderStepped:Connect(function()
    if not freecamActive then return end
    local cam = workspace.CurrentCamera
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp then freecamCenter = hrp.Position end
    if not freecamCenter then return end
    local rotation = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
    cam.CFrame = CFrame.new(freecamCenter) * rotation * CFrame.new(0, 0, freecamZoom)
end)

