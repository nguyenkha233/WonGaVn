local originals = {}
local atkRemotesGlobal = {}
for _, v in pairs(RS:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local n = v.Name:lower()
        if n:find("attack") or n:find("bite") or n:find("hit") or n:find("damage") then
            table.insert(atkRemotesGlobal, v)
            if #atkRemotesGlobal >= 3 then break end
        end
    end
end
local function applyHitbox(pl)
    if pl == LP then return end
    local c = pl.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not originals[pl] then
        originals[pl] = {Size=hrp.Size, Transparency=hrp.Transparency, Material=hrp.Material, CanCollide=hrp.CanCollide, Color=hrp.Color}
    end
    hrp.Size = Vector3.new(S.hitboxSize, S.hitboxSize, S.hitboxSize)
    hrp.Transparency = 1
    hrp.CanCollide = false
end
local function resetHitbox(pl)
    if pl == LP then return end
    local c = pl.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local o = originals[pl]
    if o then
        hrp.Size = o.Size; hrp.Transparency = o.Transparency
        hrp.Material = o.Material; hrp.CanCollide = o.CanCollide
        hrp.Color = o.Color; originals[pl] = nil
    end
end

