-- Portal TP loop
task.spawn(function()
    local v = MY_VERSION
    local inZone = {}
    while _G.WGVersion == v do
        if #portals >= 2 then
            local c = LP.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if root then
                local myPos = root.Position
                for i, info in ipairs(portals) do
                    local dist = (myPos - info.pos).Magnitude
                    local inside = dist < S.portalRange
                    if inside and not inZone[i] then
                        local nextIdx = (i % #portals) + 1
                        local nextPortal = portals[nextIdx]
                        if nextPortal then
                            root.CFrame = CFrame.new(nextPortal.pos + Vector3.new(0, 5, 0))
                            inZone[nextIdx] = true
                        end
                    end
                    inZone[i] = inside
                end
            end
        end
        task.wait(0.3)
    end
end)

