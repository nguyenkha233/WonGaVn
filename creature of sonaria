-- FREECAM MỚI (giống Roblox mặc định — zoom không giới hạn)
local freecamActive = false
local freecamConnections = {}
local freecamDistance = 15
local freecamYaw = 0
local freecamPitch = 0
local freecamLastPan = nil
local freecamInitialSet = false

local function startFreecam()
    if freecamActive then return end
    freecamActive = true

    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Scriptable

    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local cf = cam.CFrame
    if hrp then
        local offset = cf.Position - hrp.Position
        freecamDistance = math.max(offset.Magnitude, 15)
    else
        freecamDistance = 15
    end
    freecamYaw = math.atan2(-cf.LookVector.X, -cf.LookVector.Z)
    freecamPitch = math.asin(math.clamp(cf.LookVector.Y, -1, 1))
    freecamLastPan = nil

    table.insert(freecamConnections, RunService.RenderStepped:Connect(function()
        local chr = LP.Character
        local r = chr and chr:FindFirstChild("HumanoidRootPart")
        if not r then return end
        local focus = r.Position + Vector3.new(0, 1.5, 0)
        local rot = CFrame.Angles(0, freecamYaw, 0) * CFrame.Angles(freecamPitch, 0, 0)
        cam.CFrame = CFrame.new(focus) * rot * CFrame.new(0, 0, freecamDistance)
    end))

    -- PC: chuột phải xoay, scroll zoom
    table.insert(freecamConnections, UIS.InputChanged:Connect(function(input)
        if not freecamActive then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local d = input.Delta
                local sens = S.freecamSensitivity or 0.5
                freecamYaw = freecamYaw - math.rad(d.X * sens)
                freecamPitch = math.clamp(freecamPitch - math.rad(d.Y * sens), -math.rad(85), math.rad(85))
            end
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            local maxZoom = S.freecamMaxZoom or 10000
            freecamDistance = math.clamp(freecamDistance - input.Position.Z * 5, 1, maxZoom)
        end
    end))

    -- Mobile: 1 ngón kéo để xoay, 2 ngón pinch để zoom
    table.insert(freecamConnections, UIS.TouchPan:Connect(function(touchPositions, totalTranslation, velocity, state)
        if not freecamActive then return end
        if state == Enum.UserInputState.Begin then
            freecamLastPan = totalTranslation
            return
        end
        if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
            freecamLastPan = nil
            return
        end
        if #touchPositions == 1 then
            if freecamLastPan then
                local delta = totalTranslation - freecamLastPan
                local sens = S.freecamSensitivity or 0.5
                freecamYaw = freecamYaw - math.rad(delta.X * sens)
                freecamPitch = math.clamp(freecamPitch - math.rad(delta.Y * sens), -math.rad(85), math.rad(85))
            end
            freecamLastPan = totalTranslation
        end
    end))

    -- Pinch zoom (2 ngón)
    table.insert(freecamConnections, UIS.TouchPinch:Connect(function(touchPositions, scale, velocity, state)
        if not freecamActive then return end
        local maxZoom = S.freecamMaxZoom or 10000
        freecamDistance = math.clamp(freecamDistance / scale, 1, maxZoom)
    end))

    -- 2 ngón pan để zoom (dự phòng cho thiết bị không hỗ trợ pinch tốt)
    table.insert(freecamConnections, UIS.TouchPan:Connect(function(touchPositions, totalTranslation, velocity, state)
        if not freecamActive then return end
        if #touchPositions >= 2 and state == Enum.UserInputState.Change then
            if freecamLastPan then
                local deltaY = totalTranslation.Y - freecamLastPan.Y
                local maxZoom = S.freecamMaxZoom or 10000
                freecamDistance = math.clamp(freecamDistance + deltaY * 2, 1, maxZoom)
            end
            freecamLastPan = totalTranslation
        end
    end))
end

local function stopFreecam()
    if not freecamActive then return end
    freecamActive = false
    for _, c in ipairs(freecamConnections) do
        pcall(function() c:Disconnect() end)
    end
    freecamConnections = {}
    local cam = workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then cam.CameraSubject = h end
    UIS.MouseBehavior = Enum.MouseBehavior.Default
end

