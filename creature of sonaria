local AOE_COOLDOWN = 0.5
local atkRemotesGlobal = {}
local aoeThread = nil

for _, v in pairs(RS:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local n = v.Name:lower()
        if n:find("attack") or n:find("bite") or n:find("hit") or n:find("damage") then
            table.insert(atkRemotesGlobal, v)
            if #atkRemotesGlobal >= 2 then break end
        end
    end
end

local function fireAoe()
    if not S.aoeOn then return end
    local now = tick()
    if now - aoeCooldown < AOE_COOLDOWN then return end
    aoeCooldown = now

    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos = root.Position
    local rangeSq = S.aoeRange * S.aoeRange

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then
            local pc = pl.Character
            if pc then
                local h = pc:FindFirstChildOfClass("Humanoid")
                local r = pc:FindFirstChild("HumanoidRootPart")
                if h and r and h.Health > 0 then
                    local dx = r.Position.X - myPos.X
                    local dy = r.Position.Y - myPos.Y
                    local dz = r.Position.Z - myPos.Z
                    if dx*dx + dy*dy + dz*dz <= rangeSq then
                        for _, rmt in ipairs(atkRemotesGlobal) do
                            pcall(function() rmt:FireServer(pc) end)
                        end
                    end
                end
            end
        end
    end
end

local function startAoeLoop()
    if aoeThread then return end
    aoeThread = task.spawn(function()
        while S.aoeOn do
            pcall(fireAoe)
            task.wait(0.1)
        end
        aoeThread = nil
    end)
end

