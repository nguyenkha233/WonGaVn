local function applyPlayerESP()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then
            local c = pl.Character
            if c then
                if not c:FindFirstChild("WG_ESP_HL") then makePlayerESP(c) end
                if S.espInfo == "name" then
                    local head = c:FindFirstChild("Head")
                    if head and not head:FindFirstChild("WG_ESP_Name") then makeNameTag(pl) end
                end
            end
        end
    end
end

local function clearMushroomESP()
    for _, data in pairs(mushroomESP) do
        if data.hl then data.hl:Destroy() end
        if data.bb then data.bb:Destroy() end
    end
    mushroomESP = {}
end

local function applyMushroomESP()
    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos = root.Position
    local MAXD = 3000 * 3000
    local MAXC = 80
    local count = 0
    local current = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if count >= MAXC then break end
        if (obj:IsA("BasePart") or obj:IsA("Model")) and obj.Parent then
            local ok, ctype = detectShroom(obj)
            if ok then
                local p = getShroomPos(obj)
                if p then
                    local d2 = (p - myPos).Magnitude
                    if d2 * d2 <= MAXD then
                        count = count + 1
                        local target = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
                        if target then
                            current[target] = true
                            if not mushroomESP[target] then
                                local hl, bb = makeShroomESP(target, ctype or "red")
                                mushroomESP[target] = {hl = hl, bb = bb}
                            end
                        end
                    end
                end
            end
        end
    end
    for part, data in pairs(mushroomESP) do
        if not current[part] or not part.Parent then
            if data.hl then data.hl:Destroy() end
            if data.bb then data.bb:Destroy() end
            mushroomESP[part] = nil
        end
    end
end

