local farmThread = nil

local function isMushroom(part)
    if not part or not part.Name then return false end
    local n = part.Name:lower()
    return n:find("mushroom") or n:find("shroom") or n:find("shoom") or n:find("pile")
end

local function findAllMushrooms(range)
    local list = {}
    local c = LP.Character
    if not c then return list end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return list end
    local myPos = root.Position
    local rangeSq = range * range

    local function scan(parent, depth)
        if depth > 8 then return end
        for _, obj in ipairs(parent:GetChildren()) do
            if obj:IsA("BasePart") and isMushroom(obj) then
                local d2 = (obj.Position - myPos).Magnitude
                if d2 * d2 <= rangeSq then
                    table.insert(list, obj)
                end
            elseif obj:IsA("Model") or obj:IsA("Folder") then
                scan(obj, depth + 1)
            end
        end
    end
    scan(workspace, 0)
    return list
end

local function tpTo(part)
    local c = LP.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
end

local function tryCollect(part)
    if not part or not part.Parent then return end
    for _, v in pairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("collect") or n:find("pick") or n:find("interact")
               or n:find("mush") or n:find("harvest") or n:find("grab") then
                pcall(function() v:FireServer(part) end)
                pcall(function() v:FireServer(part.Position) end)
            end
        end
    end
    local c = LP.Character
    if c then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp and firetouchinterest then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                task.wait()
                firetouchinterest(hrp, part, 1)
            end)
        end
    end
end

local function startAutoFarm()
    if farmThread then pcall(function() task.cancel(farmThread) end) end
    farmThread = task.spawn(function()
        while S.autoFarmOn do
            local mushrooms = findAllMushrooms(S.farmRange)
            if #mushrooms > 0 then
                table.sort(mushrooms, function(a, b)
                    local c = LP.Character
                    local root = c and c:FindFirstChild("HumanoidRootPart")
                    if not root then return false end
                    return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
                end)
                for _, m in ipairs(mushrooms) do
                    if not S.autoFarmOn then break end
                    if not m.Parent then continue end
                    tpTo(m)
                    task.wait(0.15)
                    tryCollect(m)
                    task.wait(S.farmDelay)
                end
            else
                task.wait(2)
            end
        end
    end)
end

local function stopAutoFarm()
    if farmThread then
        pcall(function() task.cancel(farmThread) end)
        farmThread = nil
    end
end

