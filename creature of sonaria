                            .. (t.direction == "received" and "Nhận từ " or "Gửi cho ") .. t.trader .. ": " .. t.item
                    end
                end
                Rayfield:Notify({Title = "📋 Lịch sử", Content = text, Duration = 15})
                log(text)
            end})
    end
end

