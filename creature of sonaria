            Name = "📋 Xem lịch sử giao dịch",
            Callback = function()
                local text = "=== LỊCH SỬ GIAO DỊCH ===\n"
                if #S.tradeLog == 0 then text = text .. "(Chưa có giao dịch nào)"
                else
                    for i, t in ipairs(S.tradeLog) do
                        if i > 15 then break end
                        text = text .. "\n" .. i .. ". [" .. t.time .. "] "
                            .. (t.direction == "received" and "Nhận từ " or "Gửi cho ")
                            .. t.trader .. " — " .. t.item
