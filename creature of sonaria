end
local antibanDone = false
local function enableAntiban()
    if antibanDone then return end
    antibanDone = true
    local mt = getrawmetatable and getrawmetatable(game)
    if mt and newcclosure and setreadonly then
        setreadonly(mt, false)
        local oldNC = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local m = getnamecallmethod()
            if m == "Kick" then return end
            if m == "FireServer" or m == "InvokeServer" then
                for _, a in ipairs({...}) do
                    if isBlocked(a) then return end
                    if typeof(a) == "Instance" and a.Name and isBlocked(a.Name) then return end
                end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
    end
    warn = function() end
