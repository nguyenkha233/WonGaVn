            end
        end
    end
end)

local function isMushroomName(n)
    if not n then return false end
    n = n:lower()
    return n:find("mushroom") ~= nil
        or n:find("shroom") ~= nil
        or n:find("shoom") ~= nil
        or n:find("mushie") ~= nil
end

-- QUÉT TOÀN BỘ WORKSPACE — KHÔNG GIỚI HẠN ĐỘ SÂU
local function findMushrooms()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and isMushroomName(obj.Name) then
            table.insert(list, obj)
        end
    end
    return list
end

local function getMushroomPos(m)
    if not m or not m.Parent then return nil end
    if m:IsA("BasePart") then return m.Position end
    return nil
end

local function collectMushroom(m)
    if not m or not m.Parent then return end
    for _, r in ipairs(collectRemotes) do
        pcall(function() r:FireServer(m) end)
    end
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if hrp and firetouchinterest and m:IsA("BasePart") then
        pcall(function()
            firetouchinterest(hrp, m, 0)
            firetouchinterest(hrp, m, 1)
        end)
    end
end

local questCount = 0
local collected = setmetatable({}, {__mode = "k"})

local function pickNewArea(root)
    local angle = math.random() * math.pi * 2
    local dist = 400 + math.random() * 400
    local curPos = root.Position
    local newPos = Vector3.new(curPos.X + math.cos(angle) * dist, 100, curPos.Z + math.sin(angle) * dist)
    root.CFrame = CFrame.new(newPos)
    task.wait(0.5)
end

local function startAutoFarm()
    if farmThread then pcall(function() task.cancel(farmThread) end) end
    questCount = 0
    collected = setmetatable({}, {__mode = "k"})
    farmThread = task.spawn(function()
        while S.autoFarmOn do
            local c = LP.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if not root then task.wait(0.5); continue end

            local mushrooms = findMushrooms()
            local fresh = {}
            for _, m in ipairs(mushrooms) do
                if not collected[m] then
                    table.insert(fresh, m)
                end
            end

            if #fresh == 0 then
                task.wait(1)
                continue
            end

            local myPos = root.Position
            local best, bestD = nil, math.huge
            for _, m in ipairs(fresh) do
                local p = getMushroomPos(m)
                if p then
                    local d = (p - myPos).Magnitude
                    if d < bestD then best, bestD = m, d end
                end
            end

            if best then
                local pos = getMushroomPos(best)
                if pos then
                    root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
                    task.wait(0.1)
                    collectMushroom(best)
                    collected[best] = true
                    questCount = questCount + 1
                    task.wait(0.15)

                    if questCount >= 3 then
                        questCount = 0
                        pickNewArea(root)
                        collected = setmetatable({}, {__mode = "k"})
                    end
                end
            else
                task.wait(0.3)
            end
        end
    end)
end

local function stopAutoFarm()
    if farmThread then
        pcall(function() task.cancel(farmThread) end)
        farmThread = nil
    end
end

