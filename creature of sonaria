local function saveFullConfig()
    if not writefile then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            lang=S.lang, hitboxOn=S.hitboxOn, hitboxSize=S.hitboxSize,
            aoeOn=S.aoeOn, aoeRange=S.aoeRange,
