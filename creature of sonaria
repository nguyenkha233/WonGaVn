local function applyMenuTheme()
    if not S.effects then return end
    task.wait(1.0)
    local rayGui = nil
    for _, g in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if g:IsA("ScreenGui") then
            local nm = g.Name:lower()
            if nm:find("rayfield") or nm:find("sirius") then rayGui = g; break end
        end
    end
    if not rayGui then return end
    local accents = {normal=Color3.fromRGB(100,200,255), neko=Color3.fromRGB(255,150,220),
        demon=Color3.fromRGB(220,60,60), king=Color3.fromRGB(255,200,60),
        hacker=Color3.fromRGB(80,255,140), god=Color3.fromRGB(200,160,255),
        pervert=Color3.fromRGB(255,100,180)}
    local accent = accents[S.personality] or accents.normal
    for _, child in ipairs(rayGui:GetDescendants()) do
        if child:IsA("GuiObject") then
            pcall(function()
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    child.TextColor3 = Color3.fromRGB(240,245,255)
                end
                if (child:IsA("Frame") or child:IsA("TextButton")) then
                    local abs = child.AbsoluteSize
                    if abs.X > 60 and abs.X < 320 and abs.Y > 20 and abs.Y < 70 then
                        if not child:FindFirstChildOfClass("UIStroke") then
                            local stroke = Instance.new("UIStroke")
                            stroke.Color = accent; stroke.Thickness = 1; stroke.Transparency = 0.75
                            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                            stroke.Parent = child
                        end
                    end
                end
            end)
        end
    end
end

local function doUnlock()
    if S.utilityUnlocked then
        Rayfield:Notify({Title = "🔓", Content = "đã mở rồi.", Duration = 3}); return
    end
    task.spawn(function()
        for i = 1, 15 do
            pcall(function()
                Rayfield:Notify({Title = "💥 sức mạnh đang tràn về...",
                    Content = string.rep("▓", i) .. string.rep("░", 15-i) .. " " .. math.floor(i/15*100) .. "%",
                    Duration = 1})
            end)
            task.wait(0.22)
        end
    end)
    task.wait(15 * 0.22 + 0.3)
    S.utilityUnlocked = true
    if writefile then pcall(function() writefile("WonGaVn_Seal.txt", "unlocked") end) end
    saveFullConfig()
    Rayfield:Notify({Title = "🔥 " .. S.systemName, Content = getPLine("unlock"), Duration = 4})
    task.wait(1.5)
    Rayfield:Notify({Title = "⚡ " .. S.systemName, Content = getPLine("powerRelease"), Duration = 4})
    task.wait(1.5)
    Rayfield:Notify({Title = "🌟", Content = "đang khởi động lại hệ thống...", Duration = 5})
    task.wait(2)
    restartScript()
end

