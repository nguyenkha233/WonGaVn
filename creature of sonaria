local attackRemotes = {}
for _, v in pairs(RS:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local n = v.Name:lower()
        if n:find("attack") or n:find("bite") or n:find("hit") or n:find("damage") then
            table.insert(attackRemotes, v)
            if #attackRemotes >= 3 then break end
        end
    end
end

local biteAuraThread = nil

local function startBiteAura()
    if biteAuraThread then pcall(function() task.cancel(biteAuraThread) end) end
    biteAuraThread = task.spawn(function()
        local lastFire = 0
        while S.biteAuraOn do
            local c = LP.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if root then
                local myPos = root.Position
                local rangeSq = S.biteAuraRange * S.biteAuraRange
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LP then
                        local pc = pl.Character
                        if pc then
                            local h = pc:FindFirstChildOfClass("Humanoid")
                            local r = pc:FindFirstChild("HumanoidRootPart")
                            if h and r and h.Health > 0 then
                                local dx = r.Position.X - myPos.X
                                local dy = r.Position.Y - myPos.Y
                                local dz = r.Position.Z - myPos.Z
                                if dx*dx + dy*dy + dz*dz <= rangeSq then
                                    -- fire tất cả remote attack
                                    for _, rmt in ipairs(attackRemotes) do
                                        pcall(function() rmt:FireServer(pc) end)
                                        pcall(function() rmt:FireServer(h) end)
                                        pcall(function() rmt:FireServer(pc, S.biteAuraDamage) end)
                                    end
                                    -- set HP trực tiếp (dự phòng)
                                    pcall(function()
                                        h.Health = h.Health - S.biteAuraDamage
                                    end)
                                end
                            end
                        end
                    end
                end
            end
            task.wait(0.1 + math.random() * 0.1)
        end
    end)
end

local function stopBiteAura()
    if biteAuraThread then
        pcall(function() task.cancel(biteAuraThread) end)
        biteAuraThread = nil
    end
end

