local function waitForHeal(minHp, maxWait)
    local waited = 0
    while getHpPercent() < minHp and waited < (maxWait or 15) do
        if not S.autoFarmOn then return end
        task.wait(0.5)
        waited = waited + 0.5
    end
end

local function startAutoFarm()
    if farmThread then pcall(function() task.cancel(farmThread) end) end
    collected = setmetatable({}, {__mode = "k"})
    shroomStats = {red = 0, blue = 0, gold = 0}
    farmThread = task.spawn(function()
        local regionIndex = 1
        while S.autoFarmOn do
            local c = LP.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if not root then task.wait(1); continue end

            local qCur, qTotal = readShroomQuest()
            if qCur and qTotal and qCur >= qTotal then
                pcall(function()
                    Rayfield:Notify({Title = "✅ " .. S.systemName,
                        Content = "nhiệm vụ hoàn thành " .. qCur .. "/" .. qTotal .. " — chuyển khu!",
                        Duration = 5})
                end)
                regionIndex = regionIndex + 1
                if regionIndex > #MAP_REGIONS then regionIndex = 1 end
                local region = MAP_REGIONS[regionIndex]
                safeTp(root, Vector3.new(region.x, 100, region.z))
                collected = setmetatable({}, {__mode = "k"})
                task.wait(2.5)
                continue
            end

            if getHpPercent() < 40 then
                pcall(function()
                    Rayfield:Notify({Title = "💀 " .. S.systemName,
                        Content = "máu nguy hiểm — tạm dừng đợi hồi...",
                        Duration = 3})
                end)
                waitForHeal(75, 25)
            end

            local shroomList = findShrooms()
            local fresh = {}
            for _, item in ipairs(shroomList) do
                if not collected[item.obj] then
                    table.insert(fresh, item)
                end
            end

            if #fresh == 0 then
                regionIndex = regionIndex + 1
                if regionIndex > #MAP_REGIONS then regionIndex = 1 end
                local region = MAP_REGIONS[regionIndex]
                pcall(function()
                    Rayfield:Notify({Title = "🍄 " .. S.systemName,
                        Content = "hết nấm — tới " .. region.name .. "...",
                        Duration = 3})
                end)
                safeTp(root, Vector3.new(region.x, 100, region.z))
                collected = setmetatable({}, {__mode = "k"})
                task.wait(2.5)
                continue
            end

            local clusters = clusterShrooms(fresh, 350)
            local myPos = root.Position
            table.sort(clusters, function(a, b)
                return (a.center - myPos).Magnitude < (b.center - myPos).Magnitude
            end)

            local targetCluster = clusters[1]
            if not targetCluster then task.wait(1); continue end

            safeTp(root, targetCluster.center)
            task.wait(0.5)

            table.sort(targetCluster.members, function(a, b)
                local pa = getShroomPos(a.obj)
                local pb = getShroomPos(b.obj)
                if not pa or not pb then return false end
                return (pa - targetCluster.center).Magnitude < (pb - targetCluster.center).Magnitude
            end)

            for _, item in ipairs(targetCluster.members) do
                if not S.autoFarmOn then break end
                if collected[item.obj] then continue end

                local cCur, cTotal = readShroomQuest()
                if cCur and cTotal and cCur >= cTotal then
                    pcall(function()
                        Rayfield:Notify({Title = "✅ " .. S.systemName,
                            Content = "đủ quest " .. cCur .. "/" .. cTotal .. " — chuyển khu!",
                            Duration = 4})
                    end)
                    regionIndex = regionIndex + 1
                    if regionIndex > #MAP_REGIONS then regionIndex = 1 end
                    local region = MAP_REGIONS[regionIndex]
                    safeTp(root, Vector3.new(region.x, 100, region.z))
                    collected = setmetatable({}, {__mode = "k"})
                    task.wait(2)
                    break
                end

                if getHpPercent() < 45 then
                    waitForHeal(70, 15)
                end

                local pos = getShroomPos(item.obj)
                if pos then
                    safeTp(root, pos)
                    task.wait(0.4)
                    collectShroom(item.obj)
                    collected[item.obj] = true

                    local ctype = item.colorType or "red"
                    shroomStats[ctype] = (shroomStats[ctype] or 0) + 1
                    updateShroomNotify()

                    task.wait(0.5)
                end
            end

            task.wait(1)
        end
    end)
end

