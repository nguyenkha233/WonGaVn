        end
        if isfile("WonGaVn_Personality.txt") then
            local p = readfile("WonGaVn_Personality.txt")
            if p and #p > 0 then S.personality = p end
        end
        if isfile("WonGaVn_Seal.txt") then S.utilityUnlocked = true end
        if isfile("WonGaVn_Trades.json") then
            local d = HttpService:JSONDecode(readfile("WonGaVn_Trades.json"))
            if type(d) == "table" then S.tradeLog = d end
        end
    end
end)

local function restartScript()
    _G.WGVersion = _G.WGVersion + 1
    saveFullConfig()
    pcall(function()
        for _, g in ipairs(game:GetService("CoreGui"):GetChildren()) do
            local nm = g.Name:lower()
            if nm:find("rayfield") or nm:find("sirius") or nm:find("wg_") then g:Destroy() end
        end
    end)
    task.wait(1.5)
    pcall(function() loadstring(game:HttpGet(SCRIPT_URL))() end)
end

