-- CONFIG SAVE/LOAD
local CONFIG_FILE = "WonGaVn_Config.json"
local function saveFullConfig()
    if not writefile then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode({
            lang=S.lang, hitboxOn=S.hitboxOn, hitboxSize=S.hitboxSize,
            aoeOn=S.aoeOn, aoeRange=S.aoeRange,
            espInfo=S.espInfo, espPlayers=S.espPlayers, espMushrooms=S.espMushrooms,
            effects=S.effects, systemName=S.systemName, personality=S.personality,
            utilityUnlocked=S.utilityUnlocked,
            walkSpeed=S.walkSpeed, jumpPower=S.jumpPower, infJump=S.infJump,
            flySpeed=S.flySpeed, portalRange=S.portalRange,
            spamChatMsg=S.spamChatMsg, spamChatDelay=S.spamChatDelay,
            bypassMode=S.bypassMode, playerJoinAlert=S.playerJoinAlert,
            dragMenu=S.dragMenu, freecamFollow=S.freecamFollow, freecamZoom=S.freecamZoom,
        }))
    end)
end
local function loadFullConfig()
    if not (readfile and isfile) then return end
    pcall(function()
        if isfile(CONFIG_FILE) then
            local d = HttpService:JSONDecode(readfile(CONFIG_FILE))
            for k, v in pairs(d) do S[k] = v end
        end
    end)
end
loadFullConfig()

pcall(function()
    if readfile and isfile then
        if isfile("WonGaVn_Name.txt") then
            local n = readfile("WonGaVn_Name.txt")
            if n and #n > 0 then S.systemName = n end
        end
        if isfile("WonGaVn_Personality.txt") then
            local p = readfile("WonGaVn_Personality.txt")
            if p and #p > 0 then S.personality = p end
        end
        if isfile("WonGaVn_Seal.txt") then S.utilityUnlocked = true end
        if isfile("WonGaVn_Trades.json") then
            local d = HttpService:JSONDecode(readfile("WonGaVn_Trades.json"))
            if type(d) == "table" then S.tradeLog = d end
        end
    end
end)

local function restartScript()
    _G.WGVersion = _G.WGVersion + 1
    saveFullConfig()
    pcall(function()
        for _, g in ipairs(game:GetService("CoreGui"):GetChildren()) do
            local nm = g.Name:lower()
            if nm:find("rayfield") or nm:find("sirius") or nm:find("wg_") then g:Destroy() end
        end
    end)
    pcall(function()
        if gethui then
            for _, g in ipairs(gethui():GetChildren()) do
                local nm = g.Name:lower()
                if nm:find("rayfield") or nm:find("sirius") or nm:find("wg_") then g:Destroy() end
            end
        end
    end)
    task.wait(1.5)
    pcall(function() loadstring(game:HttpGet(SCRIPT_URL))() end)
end

